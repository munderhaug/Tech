# StageOps configuration. Copy to .env.local and adjust.

# AI rider-extraction provider (HANDOVER: must be swappable, host undecided).
# Only "mock" is wired this session (heuristic, no network, no key).
# To add a real provider, implement an LlmProvider and register it in
# src/services/extraction/index.ts, then set this + the endpoint below.
VITE_LLM_PROVIDER=mock

# For a future cloud or self-hosted OpenAI-compatible endpoint:
# VITE_LLM_BASE_URL=
# (The model key stays server-side — never expose it to the browser.)

# Supabase / PowerSync (wire later — see README "Wiring the real backend").
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_POWERSYNC_URL=
